{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.23.0 install --frozen-lockfile --filter \"@petrolpump/web...\" --filter petrolpump-monorepo",
  "buildCommand": "npx --yes pnpm@11.23.0 --filter @petrolpump/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/*.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
