# Root Environment Configuration Template
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/petrolpump?replicaSet=rs0

# API Server
PORT=5000
API_URL=http://localhost:5000

# Auth
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Seed Defaults
DEFAULT_OWNER_PHONE=9876543210
DEFAULT_OWNER_PASSWORD=Admin@12345
DEFAULT_OWNER_PIN=1234

# Client URLs (CORS)
WEB_APP_ORIGIN=http://localhost:5173
MOBILE_APP_SCHEME=petrolpump


# ---------------------------------------------------------------
# Vercel deployment (web app + /api functions) – set these in
# Vercel → Project → Settings → Environment Variables.
# For local `pnpm dev`, put them in a repo-root .env.local file.
# ---------------------------------------------------------------
# MongoDB Atlas connection string (required)
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/fuel_ledger
# Password everyone types to open the ledger (required)
# APP_PASSWORD=choose-a-strong-password
# Optional: database name if not in the URI (default fuel_ledger)
# MONGODB_DB=fuel_ledger
# Optional: separate signing secret for login tokens
# AUTH_SECRET=
